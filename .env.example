# NearGram — variáveis de ambiente (referência)
# Copie este arquivo para .env (local) ou configure as mesmas variáveis no Render.
# As chaves VAPID reais ficam em .env (que NÃO é commitado) — gere as suas com: python tools/gen_vapid.py

# --- Web Push (VAPID) ---
# Gere um par com: python tools/gen_vapid.py
VAPID_PUBLIC_KEY=coloque_a_chave_publica_aqui
VAPID_PRIVATE_KEY=coloque_a_chave_privada_aqui
VAPID_SUBJECT=mailto:admin@neargram.app

# --- Fotos externas (Cloudinary) ---
# Se ambas estiverem definidas, as fotos novas vão para o Cloudinary (URL salva).
# Se não, as fotos ficam em base64 no banco.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# --- Banco ---
# Se vazio, usa SQLite (data.db). Para PostgreSQL, ex.:
# DATABASE_URL=postgres://user:pass@host:5432/neargram
DATABASE_URL=
